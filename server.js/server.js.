
const express = require("express");
const multer = require("multer");

const app = express();
const upload = multer({
  storage: multer.memoryStorage(),
  limits: { fileSize: 20 * 1024 * 1024 }
});

app.use(express.static("."));
app.use(express.json());

const API_KEY = process.env.RUNWAYML_API_SECRET;
const API_URL = "https://api.dev.runwayml.com/v1";

app.post("/api/generate", upload.single("image"), async (req, res) => {
  try {
    if (!API_KEY) {
      return res.status(500).json({
        error: "API Key belum dipasang di server."
      });
    }

    const prompt = String(req.body.prompt || "").trim();
    const duration = Number(req.body.duration || 5);
    const ratio = req.body.ratio === "9:16"
      ? "720:1280"
      : "1280:720";

    if (!prompt) {
      return res.status(400).json({ error: "Prompt kosong." });
    }

    if (!Number.isInteger(duration) || duration < 4 || duration > 30) {
      return res.status(400).json({
        error: "Durasi harus 4 sampai 30 detik."
      });
    }

    const body = {
      model: "seedance2_5",
      promptText: prompt,
      duration,
      ratio,
      audio: true
    };

    let endpoint = "/text_to_video";

    if (req.file) {
      const mime = req.file.mimetype;
      if (!["image/jpeg", "image/png", "image/webp"].includes(mime)) {
        return res.status(400).json({
          error: "Foto harus JPG, PNG, atau WebP."
        });
      }

      body.promptImage =
        `data:${mime};base64,${req.file.buffer.toString("base64")}`;

      endpoint = "/image_to_video";
    }

    const response = await fetch(API_URL + endpoint, {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${API_KEY}`,
        "X-Runway-Version": "2024-11-06",
        "Content-Type": "application/json"
      },
      body: JSON.stringify(body)
    });

    const data = await response.json();

    if (!response.ok) {
      return res.status(response.status).json({
        error: data
      });
    }

    res.json({
      success: true,
      taskId: data.id,
      status: data.status
    });

  } catch (error) {
    res.status(500).json({
      error: error.message
    });
  }
});

app.get("/api/status/:id", async (req, res) => {
  try {
    if (!API_KEY) {
      return res.status(500).json({ error: "API Key belum dipasang." });
    }

    const response = await fetch(
      `${API_URL}/tasks/${encodeURIComponent(req.params.id)}`,
      {
        headers: {
          "Authorization": `Bearer ${API_KEY}`,
          "X-Runway-Version": "2024-11-06"
        }
      }
    );

    const data = await response.json();
    res.status(response.status).json(data);

  } catch (error) {
    res.status(500).json({ error: error.message });
  }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log(`BABANG HAFEEZ AI VIDEO aktif di port ${PORT}`);
});
